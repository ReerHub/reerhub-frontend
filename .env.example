# Canonical frontend env. Copy to .env.local for local dev.
# Server-only (no NEXT_PUBLIC_*): browser calls same-origin /api/v1,
# Next proxies to API_URL via rewrites in next.config.ts.
API_URL=http://localhost:8000/api/v1
SITE_URL=http://localhost:3000
# Production (Vercel, build-time; redeploy after changing):
#   API_URL=https://api.reerhub.com/api/v1
#   SITE_URL=https://www.reerhub.com
# Google login (Google Cloud Console → OAuth client, public identifier):
# GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
# Bot protection (Cloudflare Turnstile, invisible) on signup + forgot-password.
# Unset locally: forms submit without a token (backend bypasses in dev).
# TURNSTILE_SITE_KEY=<turnstile-site-key>
