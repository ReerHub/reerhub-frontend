# Canonical frontend env. Copy to .env.local for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel, build-time; redeploy after changing):
#   NEXT_PUBLIC_API_URL=https://api.reerhub.com/api/v1
#   NEXT_PUBLIC_SITE_URL=https://www.reerhub.com
# Google login (Google Cloud Console → OAuth client, public identifier):
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
# Bot protection (Cloudflare Turnstile, invisible) on signup + forgot-password.
# Unset locally: forms submit without a token (backend bypasses in dev).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>
# Deprecated alias (old setups). Prefer NEXT_PUBLIC_API_URL only.
# NEXT_PUBLIC_SERVER_URL=http://localhost:8000
