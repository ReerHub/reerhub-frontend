# Copy to .env.local for local development. All values are server-only.
# Browser API calls stay same-origin at /api/v1 and Next proxies them to API_URL.
API_URL=http://localhost:8000/api/v1
SITE_URL=http://localhost:3000

# Google OAuth browser client ID (public identifier; required for Google sign-in).
# GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com

# Cloudflare Turnstile site key (public identifier). It protects magic-link
# and public email-verification requests. When unset in local development,
# the backend's development bypass allows those flows to continue.
# TURNSTILE_SITE_KEY=<turnstile-site-key>
