{
  "name": "reerhub-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:ui:fixtures": "node scripts/ui-fixtures.mjs",
    "test:admin": "node --test scripts/admin-contracts.test.mjs",
    "test:seo": "node --test scripts/seo.test.mjs",
    "test:profile": "node --test scripts/profile-editor.test.mjs",
    "test:dashboard": "node --test scripts/dashboard.test.mjs",
    "test:operations": "node --test scripts/admin-operations.test.mjs",
    "test:performance": "node --test scripts/performance.test.mjs scripts/session-performance.test.mjs",
    "test:security": "node --test scripts/lint-security.test.mjs",
    "test:network:fixtures": "node scripts/network-fixtures.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "husky": "^9.1.7",
    "isomorphic-dompurify": "^4.5.0",
    "lint-staged": "^17.6.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
